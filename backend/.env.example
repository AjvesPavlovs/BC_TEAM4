# Local development uses DATABASE_URL (Docker Compose sets it automatically).
DATABASE_URL=postgresql://slicesip:change-me@localhost:5432/slicesip

# ECS/Fargate instead uses a managed RDS secret with IAM task role:
# (no database password in Terraform state, ECS env, or the repository)
# RDS_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:123456789012:secret:rds!db-...
# RDS_HOST=your-rds-endpoint.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=slicesip

AWS_REGION=eu-west-1
SQS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/slice-sip-discord-events
DISCORD_ORDERS_SECRET_ID=slice-sip/discord/orders
DISCORD_INVOICES_SECRET_ID=slice-sip/discord/invoices
DISCORD_SUPPORT_SECRET_ID=slice-sip/discord/support
DISCORD_MONITORING_SECRET_ID=slice-sip/discord/monitoring
