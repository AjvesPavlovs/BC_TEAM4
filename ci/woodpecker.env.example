# EXAMPLE ONLY. Never commit the filled-in file.
# Store actual values on EC2: /etc/slice-sip-ci/woodpecker.env (root:root, mode 0600)
WOODPECKER_HOST=https://ci.example.org
WOODPECKER_GITHUB_CLIENT=GITHUB_OAUTH_CLIENT_ID_HERE
WOODPECKER_GITHUB_SECRET=GITHUB_OAUTH_CLIENT_SECRET_HERE
WOODPECKER_AGENT_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
WOODPECKER_ADMIN=YOUR_GITHUB_USERNAME
# Temporarily true only for administrator onboarding, then false.
WOODPECKER_OPEN=false
