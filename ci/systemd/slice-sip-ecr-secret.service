[Unit]
Description=Refresh Woodpecker ECR publishing secret from EC2 IAM role
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=HOME=/root
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/usr/bin/python3 /usr/local/libexec/slice-sip-ci/refresh-ecr-woodpecker-secret.py
